{
  "_설명": "과제 A 업체별 추출 규칙 설정. 공통 4개 항목은 값 형식이 동일하고, 인코텀즈 번호만 업체별 패턴이 다르다. 새 업체 추가 시 vendors 항목만 추가하면 된다.",
  "common_fields": {
    "품번": {
      "패턴": "품번[^A-Z]{0,20}([A-Z]{2}-\\d{5}-[A-Z]{2})",
      "설명": "예: HD-48213-AB (라벨 '품번' 근처의 공통 품번 형식)"
    },
    "무게": {
      "패턴": "무게[^0-9]{0,20}([\\d,]+(?:\\.\\d+)?)\\s*kg",
      "설명": "예: 1,250.50 kg"
    },
    "수량": {
      "패턴": "수량[^0-9]{0,20}([\\d,]+)\\s*EA",
      "설명": "예: 320 EA"
    },
    "금액": {
      "패턴": "금액[^A-Z0-9]{0,20}USD\\s*([\\d,]+(?:\\.\\d+)?)",
      "설명": "예: USD 15,300.00"
    }
  },
  "fallback_fields": {
    "_설명": "표 형식 문서 등에서 라벨-값이 떨어져 있을 때 사용하는 값 형식 단독 패턴",
    "품번": "\\b([A-Z]{2}-\\d{5}-[A-Z]{2})\\b",
    "무게": "([\\d,]+(?:\\.\\d+)?)\\s*kg",
    "수량": "\\b([\\d,]+)\\s*EA\\b",
    "금액": "USD\\s*([\\d,]+(?:\\.\\d+)?)"
  },
  "vendors": {
    "대한정밀": {
      "키워드": ["대한정밀", "DAEHAN PRECISION"],
      "인코텀즈_패턴": "Incoterms\\s*[:：]?\\s*([A-Z]{3}-\\d{4}-\\d{4})",
      "인코텀즈_예시": "Incoterms : FOB-2020-1184"
    },
    "한빛금속": {
      "키워드": ["한빛금속", "HANBIT METAL"],
      "인코텀즈_패턴": "INCOTERMS\\s*NO\\.?\\s*([A-Z]{3}/\\d{4}/\\d{4})",
      "인코텀즈_예시": "INCOTERMS NO. CIF/2024/0087"
    },
    "세종산업": {
      "키워드": ["세종산업", "SEJONG INDUSTRIES"],
      "인코텀즈_패턴": "[A-Z]{3}\\s*\\(No\\.\\s*([A-Z]{3}-\\d{2}-\\d{4})\\)",
      "인코텀즈_예시": "운송조건은 EXW (No. EXW-88-0771) 조건"
    }
  }
}
